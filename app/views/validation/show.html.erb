<turbo-frame id="validation_card">
  <% if @church.present? %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 min-h-[600px] items-stretch"
         data-controller="validation"
         data-validation-lat-value="<%= @church.latitude || -14.235 %>"
         data-validation-lng-value="<%= @church.longitude || -51.925 %>">

      <!-- PAINEL ESQUERDO: Dados Cadastrais e Formulário (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4 bg-slate-900 border border-slate-800 rounded-3xl p-5 shadow-xl justify-between">
        <div>
          <!-- Header do Card com Badge PENDENTE -->
          <div class="flex justify-between items-center pb-3 border-b border-slate-800">
            <div class="flex items-center space-x-2">
              <span class="text-xs font-bold font-mono text-slate-400">TOTVS:</span>
              <span class="text-sm font-extrabold font-mono text-white"><%= @church.codigo_totvs %></span>
            </div>
            <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30">
              PENDENTE
            </span>
          </div>

          <!-- Informações Cadastrais -->
          <div class="space-y-3 mt-3">
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Nome da Igreja</p>
              <h2 class="text-base font-extrabold text-white leading-snug"><%= @church.nome %></h2>
              <% if @church.respond_to?(:porte) && @church.porte.present? %>
                <span class="inline-block text-[10px] font-bold text-indigo-400 bg-indigo-950/60 border border-indigo-800/80 px-2 py-0.5 rounded-md mt-1">
                  <%= @church.porte %>
                </span>
              <% end %>
            </div>

            <div>
              <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Endereço Completo</p>
              <p class="text-xs font-semibold text-slate-200 leading-snug">
                <%= @church.respond_to?(:endereco) && @church.endereco.present? ? @church.endereco : "Endereço não cadastrado" %>
              </p>
              <p class="text-xs text-slate-400 mt-1 font-medium">
                <%= [@church.try(:bairro), @church.try(:municipio), @church.try(:estado)].compact.reject(&:blank?).join(' - ') %>
              </p>
            </div>

            <!-- Campo para Cole de Link / Mensagem do Dirigente -->
            <div class="pt-2 border-t border-slate-800">
              <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">
                Link / Mensagem do Dirigente
              </label>
              <input type="text"
                     data-validation-target="linkInput"
                     data-action="input->validation#processLink"
                     placeholder="Cole o link do Google Maps aqui..."
                     class="w-full bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 text-xs rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500 transition-colors" />
            </div>
          </div>
        </div>

        <!-- Formulário de Atualização e Salvamento -->
        <form action="/validation/<%= @church.id %>" method="post" class="space-y-3 pt-3 border-t border-slate-800">
          <input type="hidden" name="_method" value="patch" />
          <%= token_tag nil rescue nil %>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Latitude</label>
              <input type="text"
                     name="latitude"
                     value="<%= @church.latitude %>"
                     data-validation-target="latInput"
                     class="w-full text-xs py-2 px-3 bg-slate-800 border border-slate-700 text-white font-mono font-semibold rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" />
            </div>
            <div>
              <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Longitude</label>
              <input type="text"
                     name="longitude"
                     value="<%= @church.longitude %>"
                     data-validation-target="lngInput"
                     class="w-full text-xs py-2 px-3 bg-slate-800 border border-slate-700 text-white font-mono font-semibold rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" />
            </div>
          </div>

          <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center space-x-2 active:scale-95 cursor-pointer">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Salvar e Validar Coordenadas</span>
          </button>
        </form>
      </div>

      <!-- PAINEL DIREITO: Mapa de Satélite com Marker Arrastável (7 cols) -->
      <div class="lg:col-span-7 flex flex-col bg-slate-900 border border-slate-800 rounded-3xl p-4 shadow-xl min-h-[450px] lg:min-h-0">
        <div class="flex items-center justify-between mb-3 shrink-0">
          <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center gap-1.5">
            <svg class="h-4 w-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Posicionador por Imagem de Satélite
          </h3>
          <span class="text-[10px] text-amber-400 font-semibold bg-amber-950/40 border border-amber-800/50 px-2 py-0.5 rounded-lg">
            💡 Arraste o Marker vermelho para ajustar a posição
          </span>
        </div>

        <div data-validation-target="map" class="flex-1 w-full h-full rounded-2xl overflow-hidden border border-slate-800 z-10"></div>
      </div>
    </div>
  <% else %>
    <!-- Card de Validações Concluídas -->
    <div class="w-full bg-slate-900 border border-slate-800 rounded-3xl p-12 text-center shadow-xl">
      <div class="inline-flex p-4 bg-emerald-950/60 border border-emerald-800 rounded-2xl mb-4 text-emerald-400">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Todas as igrejas pendentes foram validadas!</h3>
      <p class="text-xs text-slate-400 max-w-md mx-auto mb-6">
        Não restam registros pendentes na fila. Acesse o Mapa Geral para visualizar as igrejas georreferenciadas.
      </p>
      <a href="/" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-lg transition-all">Ir para o Mapa Geral</a>
    </div>
  <% end %>
</turbo-frame>
